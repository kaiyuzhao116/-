<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.netty_user.mapper.UserMapper">

    <resultMap id="userMap" type="com.example.demo.netty_user.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="token" property="token"/>
    </resultMap>

    <select id="selectByUsername" resultMap="userMap">
        SELECT id, username, token
        FROM t_user
        WHERE username = #{username}
    </select>

    <select id="selectByToken" resultMap="userMap">
        SELECT id, username, token
        FROM t_user
        WHERE token = #{token}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (username, token)
        VALUES (#{username}, #{token})
    </insert>

    <update id="updateToken">
        UPDATE t_user
        SET token = #{token}
        WHERE username = #{username}
    </update>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM t_user
    </select>

</mapper>
